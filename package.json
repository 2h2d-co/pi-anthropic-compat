{
  "name": "pi-anthropic-compat",
  "version": "0.0.24",
  "description": "Native Anthropic compaction compatibility for Pi",
  "keywords": [
    "pi-package"
  ],
  "homepage": "https://github.com/2h2d-co/pi-anthropic-compat#readme",
  "bugs": {
    "url": "https://github.com/2h2d-co/pi-anthropic-compat/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Kaan Ozdokmeci",
    "email": "kaan@2h2d.co",
    "url": "https://www.2h2d.co"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/2h2d-co/pi-anthropic-compat.git"
  },
  "files": [
    "extensions",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "type": "module",
  "scripts": {
    "test": "env -u PI_PACKAGE_DIR node --test --test-concurrency=1 test/*.test.ts",
    "test:live": "node scripts/test-live.ts",
    "pack:dry": "npm pack --dry-run --ignore-scripts --allow-directory=all",
    "release": "node scripts/release.ts",
    "fmt": "oxfmt",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix"
  },
  "devDependencies": {
    "@2h2d/oxlint-config": "0.1.3",
    "@2h2d/ts-config": "0.0.1",
    "@earendil-works/pi-ai": "1.6.1",
    "@earendil-works/pi-coding-agent": "1.6.1",
    "@earendil-works/pi-tui": "1.6.1",
    "@types/node": "22.20.5",
    "node-pty": "1.2.0-beta.18",
    "oxfmt": "0.79.0",
    "oxlint": "1.94.0",
    "oxlint-tsgolint": "7.0.2007",
    "pi-system-prompt-patcher": "0.0.18",
    "typebox": "1.4.7",
    "typescript": "7.0.2"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": ">=1.6.1 <1.7.0",
    "@earendil-works/pi-coding-agent": ">=1.6.1 <1.7.0",
    "@earendil-works/pi-tui": ">=1.6.1 <1.7.0"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "pi": {
    "extensions": [
      "./extensions/index.ts"
    ]
  }
}
